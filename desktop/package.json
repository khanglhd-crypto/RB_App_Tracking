{
  "name": "rb-control-desktop",
  "version": "1.0.0",
  "description": "RB Control - App Tracking (Desktop)",
  "main": "main.js",
  "author": "RedBlue",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.redblue.rbcontrol",
    "productName": "RB Control",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "icon.ico",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "backend-dist/rb-control-backend",
        "to": "backend-dist/rb-control-backend"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
